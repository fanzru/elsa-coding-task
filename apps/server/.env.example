# Copy to .env (gitignored). Every value is optional — see src/config.ts for defaults.
# Postgres for the quiz bank + session archive. Without it the server uses data/quizzes.json.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/quiz_dev
# Redis for multi-instance mode.
# REDIS_URL=redis://127.0.0.1:6379
