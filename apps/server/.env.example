# Copy to .env (gitignored). See src/config.ts for every knob and its default.
# Postgres is required: quiz bank, accounts, ranked totals and the session archive live there.
# `make pg-up` starts one in Docker that matches this URL.
DATABASE_URL=postgres://quiz:quiz@127.0.0.1:5439/quiz
# Signs login tokens (≥16 chars). Unset: fixed dev secret in development, random per boot otherwise.
# AUTH_SECRET=change-me-to-something-long-and-random
# Redis for multi-instance mode.
# REDIS_URL=redis://127.0.0.1:6379
