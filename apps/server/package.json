{
  "name": "@quiz/server",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time quiz server: WebSocket transport, per-session actor, scoring and live leaderboard",
  "type": "module",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "tsx scripts/loadtest.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@quiz/protocol": "workspace:*",
    "hono": "^4.13.8",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.10.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
